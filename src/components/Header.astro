---
const links = [
  {
    href: "/",
    text: "Inicio",
  },
  {
    href: "/sobre-mi",
    text: "Sobre mi",
  },
  {
    href: "/proyectos",
    text: "Proyectos",
  },
  {
    href: "/contacto",
    text: "Contacto",
  },
];
---

<header>
  <nav>
    {links.map((link) => (
      <a href={link.href}>{link.text}</a>
    ))}
  </nav>
</header>

<style>
  nav {
    display: flex;
    gap: 1rem;
    font-weight: 600;
    padding-block: 1rem;
  }
</style>
